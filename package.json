{
  "name": "github-release-notifier",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "password": "tsx scripts/password.ts",
    "test:watch": "vitest",
    "serve": "node dist-server/index.js",
    "check:startos": "tsc -p tsconfig.startos.json --noEmit",
    "package:startos": "node scripts/package-startos.mjs",
    "demo": "tsx scripts/demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "A self-hosted mailbox for GitHub releases",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "nodemailer": "^10.3.1",
    "nostr-tools": "^2.25.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@start9labs/start-sdk": "^3.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  }
}
